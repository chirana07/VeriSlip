# Map SHA-256 API-key fingerprints to "free" or "pro". Never store raw keys.
# Generate a random key and fingerprint with Python's `secrets` and `hashlib` modules.
# Shape: {"<64-character-sha256-fingerprint>":"free"}
VERISLIP_API_KEY_HASHES={}
# Missing keys disable protected API access by default. Only local demos should
# explicitly set VERISLIP_ENV=development to enable the public development key.
VERISLIP_ENV=production

# Optional Groth16 audit verifier. Directory must contain a versioned
# slip-audit-v1\verification_key.json generated by a reviewed ceremony.
VERISLIP_ZK_ARTIFACT_ROOT=circuits\artifacts
VERISLIP_NODE_BINARY=node
# Exact approved webhook hostnames, comma-separated. Empty disables delivery.
# Only HTTPS port 443 with public DNS addresses is accepted.
VERISLIP_WEBHOOK_HOSTS=
# Required signing secret from secret storage. Use a cryptographically random value.
VERISLIP_WEBHOOK_SECRET=

# Optional. When omitted, a process-local store is used for development/testing.
REDIS_URL=redis://localhost:6379/0

# Bounded in-process forensic worker pool and completed-job retention.
VERISLIP_JOB_WORKERS=2
VERISLIP_JOB_MAX_RECORDS=1000
VERISLIP_JOB_RETENTION_SECONDS=3600

# Metadata-only merchant verification history (local single-process store)
VERISLIP_HISTORY_MAX_RECORDS=10000
VERISLIP_HISTORY_RETENTION_DAYS=365

# WhatsApp Cloud API media retrieval. Keep the token in a secret manager in production.
VERISLIP_WHATSAPP_ACCESS_TOKEN=
VERISLIP_WHATSAPP_GRAPH_API_VERSION=v21.0

# Process-local conversation state defaults. Use shared storage for multi-worker production.
VERISLIP_WHATSAPP_SESSION_TTL_SECONDS=2592000
VERISLIP_WHATSAPP_IDEMPOTENCY_TTL_SECONDS=86400
VERISLIP_WHATSAPP_STATE_MAX_RECORDS=10000

# Merchant verification credits (business quota, separate from API rate limits).
VERISLIP_WHATSAPP_DEFAULT_TIER=free
VERISLIP_WHATSAPP_FREE_VERIFICATIONS=5
# Public HTTPS checkout/upgrade page; do not place payment credentials in this URL.
VERISLIP_WHATSAPP_UPGRADE_URL=

# Optional Dialog IdeaMart / Mobitel hSenid-compatible SMS fallback.
# Use provider-issued values from a secret manager; placeholders are intentionally blank.
VERISLIP_SMS_ENABLED=0
VERISLIP_SMS_GATEWAY_URL=
VERISLIP_SMS_APPLICATION_ID=
VERISLIP_SMS_PASSWORD=
VERISLIP_SMS_SENDER_ID=VeriSlip
VERISLIP_SMS_CONNECT_TIMEOUT_SECONDS=5
VERISLIP_SMS_READ_TIMEOUT_SECONDS=10

# Shopify orders/create webhook. Supply the secret through deployment secret storage.
VERISLIP_SHOPIFY_WEBHOOK_SECRET=
VERISLIP_SHOPIFY_MEDIA_HOSTS=cdn.shopify.com
VERISLIP_SHOPIFY_CONNECT_TIMEOUT_SECONDS=5
VERISLIP_SHOPIFY_READ_TIMEOUT_SECONDS=15
VERISLIP_SHOPIFY_IDEMPOTENCY_TTL_SECONDS=86400
VERISLIP_SHOPIFY_IDEMPOTENCY_MAX_RECORDS=10000
